# Site config: ICE (Slurm H100/H200 cluster). Source with: source sites/ice.env
# TODO(owner): fill every value marked TODO after the first login; commit the filled file to main.
export SITE=ice
export WS=TODO_ICE_WORKSPACE                                  # e.g. scratch/project path holding the clone + artifacts/
export HF_HOME=TODO_ICE_HF_CACHE                              # large, persistent; models are staged once per site
export ATLAS_PY=$WS/.venv-atlas-031-clean/bin/python          # build with: python atlas/env/build.py (same lock file)
export RUN_ROOT=TODO_ICE_RUN_ROOT                             # detached worktrees at run-* tags
export LAUNCHER=slurm                                         # see ops/ice/README.md
export SLURM_ACCOUNT=TODO                                     # sbatch --account
export SLURM_PARTITION=TODO                                   # partition with H100/H200
export SLURM_QOS=TODO                                         # if required
export SLURM_GRES=TODO                                        # e.g. gpu:H100:1 / gpu:H200:1 (record which in every run)
export PAUSE_MARKER=$WS/EXPERIMENTS_PAUSED.json               # pause contract applies on every site
