# Site config: ICE (PACE Slurm H100/H200 cluster). Usage: source sites/ice.env   (then: bash ops/ice/check_site.sh)
# Owner: replace every TODO after the first login and commit the filled file to main (no secrets in this file).
export SITE=ice
export OPERATOR=${OPERATOR:-owner}                            # recorded as launched_by in every config.json
export WS=TODO_ICE_WORKSPACE                                  # absolute path of the clone on large scratch/project storage; artifacts/ lives here
export HF_HOME=TODO_ICE_HF_CACHE                              # large persistent dir; models staged once (ops/ice/stage_models.py)
export HF_HUB_OFFLINE=1                                       # jobs never hit the Hub; staging unsets it explicitly
export ICE_PYTHON=TODO_PYTHON_3_11_5                          # interpreter used to build venvs: Python 3.11.5 (heck builds use 3.11.5)
export ATLAS_PY=$WS/.venv-atlas-031-clean/bin/python          # engine env (vLLM 0.31.0), built by ops/ice/build_envs.sh
export MAGPIE_PY=$WS/.venv-magpie/bin/python                  # Magpie prompt generation (vLLM 0.31.0 + langdetect)
export TRANSPORT_PY=$WS/.venv-transport/bin/python            # M3 training (speculators 261a82dd)
export COVARIATES_PY=$WS/.venv-covariates/bin/python          # A6 covariates
export RUN_ROOT=$WS/.worktrees                                # detached worktrees at run-* tags
export LAUNCHER=slurm                                         # ops/launch.py run --node slurm --gpus slurm
export SLURM_ACCOUNT=TODO                                     # sbatch --account
export SLURM_PARTITION=TODO                                   # partition with H100/H200
export SLURM_QOS=TODO                                         # leave TODO if not required (skipped)
export SLURM_GRES=TODO                                        # e.g. gpu:H100:1 or gpu:H200:1 (the GPU model is also logged per run)
export SLURM_TIME=08:00:00                                    # per-job wall time; training jobs may need more (override per submit)
export SLURM_CPUS=8
export SLURM_MEM=96G
export PAUSE_MARKER=$WS/EXPERIMENTS_PAUSED.json               # pause contract applies on every site
export HECK_HOST=TODO_HECK_LOGIN                              # ssh alias/host of heck reachable from ICE login (for ops/ice/sync_from_heck.sh)
export HECK_WS=/home/heck2/sbhansali8/SpecTLM                 # heck workspace (source of artifacts)
