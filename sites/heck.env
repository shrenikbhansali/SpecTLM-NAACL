# Site config: heck-srv (A40 nodes heck-srv1–5, dedicated H200 box heck-srv6). Source with: source sites/heck.env
export SITE=heck
export WS=/home/heck2/sbhansali8/SpecTLM                      # primary checkout on main; artifacts in $WS/artifacts (gitignored)
export HF_HOME=/home/heck2/sbhansali8/HFcache                 # shared HF cache (/home/heck2 is NFS on all heck nodes)
export ATLAS_PY=$WS/.venv-atlas-031-clean/bin/python          # pinned engine env, vLLM 0.31.0 (atlas/env/requirements.lock)
export RUN_ROOT=/home/heck2/sbhansali8/SpecTLM-runs            # detached worktrees at run-* tags
export LAUNCHER=ssh                                           # ops/launch.py (setsid over ssh), ops/queue.py for many cells
export NODES_A40="heck-srv1 heck-srv2 heck-srv3 heck-srv4 heck-srv5"
export NODE_TIMING=heck-srv6                                  # 4x H200: A9 wall-clock only (MASTER §8.2)
export PAUSE_MARKER=$WS/tlm-spec-maintenance/EXPERIMENTS_PAUSED.json
